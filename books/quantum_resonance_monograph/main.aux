\@writefile{lof}{\contentsline {figure}{\numberline {10.1}{\ignorespaces $l=2$, Real range Gaussian basis. The scaling angle is taken to be~$\theta =25^\circ $, $30^\circ $ on the upper panel, and $\theta =40^\circ $, $42^\circ $ on the lower panel. We take $i_{\max }=30$, $r_{*0}=0.1$, and $r_{*\max }=60$. The sequence of points aligned approximately along the $\theta $-rotated direction represents the discretized continuum spectrum, while the isolated points on the real-axis side are interpreted as resonance eigenvalues, namely the QNM frequencies. The lowest resonance candidate is $\omega _1=0.747343-\mathrm  {i}0.177958$ ($\theta =40^{\circ }$) and $\omega _1=0.747349-\mathrm  {i}0.177940$ ($\theta =42^{\circ }$). The next candidate is $\omega _2=0.750229-\mathrm  {i}0.481678$ ($\theta =40^{\circ }$) and $\omega _2=0.738955-\mathrm  {i}0.497959$ ($\theta =42^{\circ }$).}}{297}{figure.caption.95}\protected@file@percent }
\newlabel{src:2604_20442:fig:ene_l2_poly_nmax1}{{10.1}{297}{$l=2$, Real range Gaussian basis. The scaling angle is taken to be~$\theta =25^\circ $, $30^\circ $ on the upper panel, and $\theta =40^\circ $, $42^\circ $ on the lower panel. We take $i_{\max }=30$, $r_{*0}=0.1$, and $r_{*\max }=60$. The sequence of points aligned approximately along the $\theta $-rotated direction represents the discretized continuum spectrum, while the isolated points on the real-axis side are interpreted as resonance eigenvalues, namely the QNM frequencies. The lowest resonance candidate is $\omega _1=0.747343-\rmi 0.177958$ ($\theta =40^{\circ }$) and $\omega _1=0.747349-\rmi 0.177940$ ($\theta =42^{\circ }$). The next candidate is $\omega _2=0.750229-\rmi 0.481678$ ($\theta =40^{\circ }$) and $\omega _2=0.738955-\rmi 0.497959$ ($\theta =42^{\circ }$)}{figure.caption.95}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10.2}{\ignorespaces $l=2$, Polynomial $\times $ real range Gaussian basis with~$p_{\max }=3$. We take $i_{\max }=30$, $r_{*0}=0.1$, and $r_{*\max }=60$. The lowest resonance candidate is $\omega _1=0.747348-\mathrm  {i}0.177926$ ($\theta =40^{\circ }$) and $\omega _1=0.747345-\mathrm  {i}0.177925$ ($\theta =42^{\circ }$). The next candidate is $\omega _2=0.712209-\mathrm  {i}0.485971$ ($\theta =40^{\circ }$), $\omega _2=0.704895-\mathrm  {i}0.502870$ ($\theta =42^{\circ }$).}}{298}{figure.caption.96}\protected@file@percent }
\newlabel{src:2604_20442:fig:ene_l2_poly_nmax3}{{10.2}{298}{$l=2$, Polynomial $\times $ real range Gaussian basis with~$p_{\max }=3$. We take $i_{\max }=30$, $r_{*0}=0.1$, and $r_{*\max }=60$. The lowest resonance candidate is $\omega _1=0.747348-\rmi 0.177926$ ($\theta =40^{\circ }$) and $\omega _1=0.747345-\rmi 0.177925$ ($\theta =42^{\circ }$). The next candidate is $\omega _2=0.712209-\rmi 0.485971$ ($\theta =40^{\circ }$), $\omega _2=0.704895-\rmi 0.502870$ ($\theta =42^{\circ }$)}{figure.caption.96}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10.3}{\ignorespaces $l=2$, sin/cos $\times $ real range Gaussian basis. We take $i_{\max }=30$, $r_{*0}=0.1$, and $r_{*\max }=80$. The lowest resonance candidate is $\omega _1=0.743544-\mathrm  {i}0.168990$ ($\theta =40^\circ $) and $\omega _1=0.746374-\mathrm  {i}0.169193$ ($\theta =42^\circ $). The second-mode candidate is $\omega _2=0.672161-\mathrm  {i}0.389585$ ($\theta =40^\circ $) and $\omega _2=0.673930-\mathrm  {i}0.403464$ ($\theta =42^\circ $).}}{299}{figure.caption.97}\protected@file@percent }
