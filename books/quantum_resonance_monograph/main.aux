\@writefile{lof}{\contentsline {figure}{\numberline {7.6}{\ignorespaces The ground state energy of the anharmonic oscillator as a function of~$g$. The derivation is given by the variational method with the fastest apparent condition up to subleading of~$g$, and the explicit function is given by~Eq.~\eqref  {src:2510_11766:eq:ho4_energy}. The quantum numbers, $n_r$ and~$l$, are set to vanish, so $\lambda =1/2$ under the Langer correction. Typically, the energy is growing up monotonically with respect to~$g$.}}{196}{figure.caption.60}\protected@file@percent }
\newlabel{src:2510_11766:fig:ho4_energy}{{7.6}{196}{The ground state energy of the anharmonic oscillator as a function of~$g$. The derivation is given by the variational method with the fastest apparent condition up to subleading of~$g$, and the explicit function is given by~Eq.~\eqref {src:2510_11766:eq:ho4_energy}. The quantum numbers, $n_r$ and~$l$, are set to vanish, so $\lambda =1/2$ under the Langer correction. Typically, the energy is growing up monotonically with respect to~$g$}{figure.caption.60}{}}
