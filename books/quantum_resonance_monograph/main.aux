\@writefile{lof}{\contentsline {figure}{\numberline {10.18}{\ignorespaces Complex-scaled spectrum for the coupled-channel MSW black-hole perturbation problem with $\Lambda =0.08$. $l=2$. The scaling angle is $\theta =42^\circ $ and $44^\circ $. We set $i_{\max }=50$, $r_0=0.1$, and $r_{*\max }=80$. Because the asymptotic effective potential has two eigenvalue thresholds, two continuum branches are observed. Within the parameter sets examined in this work, no stable isolated resonance eigenvalue was identified for $\theta <45^\circ $. }}{334}{figure.caption.135}\protected@file@percent }
\newlabel{src:2605_03277:fig:stringy_coupled_spectrum}{{10.18}{334}{Complex-scaled spectrum for the coupled-channel MSW black-hole perturbation problem with $\Lambda =0.08$. $l=2$. The scaling angle is $\theta =42^\circ $ and $44^\circ $. We set $i_{\max }=50$, $r_0=0.1$, and $r_{*\max }=80$. Because the asymptotic effective potential has two eigenvalue thresholds, two continuum branches are observed. Within the parameter sets examined in this work, no stable isolated resonance eigenvalue was identified for $\theta <45^\circ $}{figure.caption.135}{}}
