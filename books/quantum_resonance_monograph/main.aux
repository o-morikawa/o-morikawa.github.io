\@writefile{lof}{\contentsline {figure}{\numberline {6.4}{\ignorespaces Illustration of computing Eq.~\eqref  {src:2505_02301:eq:zel_quantization}. $\beta =1$. Although $f(x)$ diverges near $|\im  x|\to \infty $, $f(-x)=-f(x)$ and hence $f(x)$ does not contribute to~$\mathrm  {e}^{I_{\mathrm  {i}\infty }}$. Note that $I_n$, $I_{\mathrm  {i}\infty }$ and $I_\infty $ are finite. (If $f=0$ then $\mathrm  {e}^{I_\infty }$ is divergent.)}}{141}{figure.caption.33}\protected@file@percent }
\newlabel{src:2505_02301:fig:zel_integration}{{6.4}{141}{Illustration of computing Eq.~\eqref {src:2505_02301:eq:zel_quantization}. $\beta =1$. Although $f(x)$ diverges near $|\im x|\to \infty $, $f(-x)=-f(x)$ and hence $f(x)$ does not contribute to~$\rme ^{I_{\rmi \infty }}$. Note that $I_n$, $I_{\rmi \infty }$ and $I_\infty $ are finite. (If $f=0$ then $\rme ^{I_\infty }$ is divergent.)}{figure.caption.33}{}}
